# OpenAI API (or any OpenAI-compatible provider)
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"

# OpenRouter (free-tier friendly; takes priority over OPENAI_API_KEY when set)
# Get a free key at https://openrouter.ai/keys, pick any ":free"-suffixed
# model from https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"

# TypeSafe JEV API
TYPESAFE_API_KEY=""

# LangSmith Observability
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="memtrace-hackathon"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# Database & Environment
MEMTRACE_DB_PATH="memtrace.db"
MEMTRACE_ENV="development"
MEMTRACE_DEFAULT_AGENT_ID="agent-alpha"
MEMTRACE_DEBUG="true"
